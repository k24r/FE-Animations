local function createCard(item)
	state.cardOrder += 1
	local card = new("Frame", { BackgroundColor3 = C.card, BorderSizePixel = 0, LayoutOrder = state.cardOrder })
	corner(card, 8)

	local thumbType = item.kind == "bundle" and "BundleThumbnail" or "Asset"
	local thumb = new("ImageButton", {
		BackgroundColor3 = C.thumb, BorderSizePixel = 0, Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 1, -50),
		ScaleType = Enum.ScaleType.Fit, AutoButtonColor = false,
		Image = item.img or ("rbxthumb://type=%s&id=%s&w=150&h=150"):format(thumbType, tostring(item.id)),
	}, card)
	corner(thumb, 6)

	local nameBtn = makeButton({
		Text = string.upper(item.name or "?"), TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.new(0, 6, 1, -38), Size = UDim2.new(1, -64, 0, 32), ZIndex = 2,
	}, card)

	local dark = Color3.fromRGB(20, 20, 22)
	local idBtn = makeButton({
		Text = "ID", TextSize = 11, BackgroundColor3 = dark, ZIndex = 3,
		Position = UDim2.new(1, -58, 0, 10), Size = UDim2.fromOffset(28, 20),
	}, card)
	local star = makeButton({
		Text = favIndex(item) and "★" or "☆", TextSize = 14, BackgroundColor3 = dark, ZIndex = 3,
		TextColor3 = favIndex(item) and C.gold or C.txt,
		Position = UDim2.new(1, -28, 0, 10), Size = UDim2.fromOffset(22, 20),
	}, card)
	local hk = makeButton({
		Text = "KEY", TextSize = 11, BackgroundColor3 = dark, ZIndex = 3,
		Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(60, 20), Visible = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, card)
	local del = makeButton({
		Text = "✕", TextSize = 11, BackgroundColor3 = dark, ZIndex = 3, TextColor3 = Color3.fromRGB(255, 120, 120),
		Position = UDim2.fromOffset(74, 10), Size = UDim2.fromOffset(22, 20), Visible = false,
	}, card)
	local edit = makeButton({ Text = "✏", TextSize = 11, BackgroundColor3 = dark, ZIndex = 4, Position = UDim2.new(1, -54, 1, -38), Size = UDim2.fromOffset(22, 20), Visible = true }, card)
	local profileSave = makeButton({ Text = "💾", TextSize = 11, BackgroundColor3 = dark, ZIndex = 4, Position = UDim2.new(1, -28, 1, -38), Size = UDim2.fromOffset(22, 20), Visible = true }, card)

	local hovered = false
	local function refreshHK()
		local e = Config.hotkeys[hkKey(item)]
		hk.Text = e and e.key or "KEY"
		hk.TextColor3 = e and C.gold or C.dim
		hk.Visible = hovered or e ~= nil
		del.Visible = hovered and state.tab ~= "favs"
		profileSave.Visible = true
	end
	refreshHK()

	card.MouseEnter:Connect(function() hovered = true; refreshHK() end)
	card.MouseLeave:Connect(function()
		if mouseInside(card) then return end
		hovered = false
		refreshHK()
	end)

	nameBtn.MouseButton1Click:Connect(function() activate(item) end)
	thumb.MouseButton1Click:Connect(function() activate(item) end)
	idBtn.MouseButton1Click:Connect(function()
		pcall(function() if setclipboard then setclipboard(tostring(item.id)) end end)
		notify("ID copied: " .. tostring(item.id))
	end)
	star.MouseButton1Click:Connect(function()
		local i = favIndex(item)
		if i then
			table.remove(Config.favs, i)
		else
			-- un favorito siempre queda tambien guardado en su pestana
			saveItem(item, true)
			return
		end
		save()
		refreshPreviewButtons()
		if state.tab == "favs" then
			showTab(nil)
		else
			star.Text = "☆"
			star.TextColor3 = C.txt
		end
	end)
	del.MouseButton1Click:Connect(function() removeItem(item) end)
	edit.MouseButton1Click:Connect(function() if openRenameItem then openRenameItem(item) end end)
	profileSave.MouseButton1Click:Connect(function() if openProfilePicker then openProfilePicker(item) end end)
	hk.MouseButton1Click:Connect(function()
		hk.Text = "..."
		hk.TextColor3 = C.white
		capture = function(kc)
			if kc == Enum.KeyCode.Escape then
				Config.hotkeys[hkKey(item)] = nil
			else
				Config.hotkeys[hkKey(item)] = { kind = item.kind, id = item.id, name = item.name, key = kc.Name }
			end
			syncActiveProfile()
			save()
			if hk.Parent then refreshHK() end
		end
	end)

	return card
end

