	local function refreshHK()
		local e = __BA_STATE.Config.hotkeys[__BA_STATE.hkKey(item)]
		hk.Text = e and e.key or "KEY"
		hk.TextColor3 = e and __BA_STATE.C.gold or __BA_STATE.C.dim
		hk.Visible = hovered or e ~= nil
		del.Visible = hovered and __BA_STATE.state.tab ~= "favs"
		profileSave.Visible = true
	end
	refreshHK()

	card.MouseEnter:Connect(function() hovered = true; refreshHK() end)
	card.MouseLeave:Connect(function()
		if __BA_STATE.mouseInside(card) then return end
		hovered = false
		refreshHK()
	end)

	nameBtn.MouseButton1Click:Connect(function() __BA_STATE.activate(item) end)
	thumb.MouseButton1Click:Connect(function() __BA_STATE.activate(item) end)
