local function unload()
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	conns = {}
	pcall(resetAnimations)
	pcall(function() gui:Destroy() end)
	if getgenv then getgenv().__BA_UNLOAD = nil end
end
if getgenv then getgenv().__BA_UNLOAD = unload end
CloseBtn.MouseButton1Click:Connect(unload)

do
	local resizing, startMouse, startSize = false, nil, nil
	connect(Grip.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			startMouse = i.Position
			startSize = Main.AbsoluteSize
		end
	end)
	connect(UIS.InputChanged, function(i)
		if resizing and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - startMouse
			local w = math.clamp(startSize.X + d.X, 440, 1000)
			local h = math.clamp(startSize.Y + d.Y, 320, 800)
			Main.Size = UDim2.fromOffset(w, h)
		end
	end)
	connect(UIS.InputEnded, function(i)
		if resizing and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
			resizing = false
			Config.w, Config.h = math.floor(Main.AbsoluteSize.X), math.floor(Main.AbsoluteSize.Y)
			save()
		end
	end)
end

----------------------------------------------------------------
-- Teclado: captura, tecla del menu y atajos
----------------------------------------------------------------
connect(UIS.InputBegan, function(input, processed)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	if capture then
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			local f = capture
			capture = nil
			f(input.KeyCode)
		end
		return
	end
	if processed then return end
	local name = input.KeyCode.Name
	if name == Config.menuKey then
		Main.Visible = not Main.Visible
		return
	end
	for _, e in pairs(Config.hotkeys) do
		if e.key == name then
			activate(e)
			break
		end
	end
end)

