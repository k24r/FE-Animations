local function makeCatalogSearchParams(keyword)
	local params = CatalogSearchParams.new()
	params.SearchKeyword = keyword or ""
	params.Limit = 28

	if catalogKind == "bundle" then
		local animationBundleType
		local enumOK = pcall(function()
			animationBundleType = Enum.BundleType.Animations
		end)
		if not enumOK or not animationBundleType then
			error("Enum.BundleType.Animations is not available in this Roblox client.")
		end
		params.BundleTypes = { animationBundleType }
	else
		local emoteAssetType
		local enumOK = pcall(function()
			emoteAssetType = Enum.AvatarAssetType.EmoteAnimation
		end)
		if not enumOK or not emoteAssetType then
			error("Enum.AvatarAssetType.EmoteAnimation is not available in this Roblox client.")
		end
		params.AssetTypes = { emoteAssetType }
	end

	return params
end

