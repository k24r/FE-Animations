-- showTab(nil) vuelve a dibujar la pestana actual
showTab = function(tab)
	local keepScroll = tab == nil
	tab = tab or state.tab
	if tab ~= state.tab then state.filter = ""; SearchBox.Text = "" end
	state.tab = tab
	updateTabStyle()
	local isMix = tab == "mix"
	local isProfiles = tab == "profiles"
	local isCatalog = tab == "catalog"
	Grid.Visible = not isMix and not isProfiles and not isCatalog
	MixPage.Visible = isMix
	ProfilePage.Visible = isProfiles
	CatalogPage.Visible = isCatalog
	SearchBox.Visible = not isProfiles and not isMix
	SearchBtn.Visible = not isProfiles and not isMix
	IdBox.Visible = not isProfiles and not isMix and not isCatalog
	ApplyBtn.Visible = not isProfiles and not isMix and not isCatalog
	EmptyLabel.Visible = false
	SearchBox.PlaceholderText = isCatalog and (catalogKind == "bundle" and "Search animation packs..." or "Search emotes...") or (tab == "favs" and "Name" or "Zombie, Cute")
	IdBox.PlaceholderText = "Url or ID"
	if isProfiles then
		setProfileMode(profileMode)
		if profileMode == "hotkeys" then renderProfiles() elseif profileMode == "emotes" then renderCollectionFolders("emote") elseif profileMode == "packs" then renderCollectionFolders("bundle") else renderMixProfiles() end
	elseif isMix then
		EmptyLabel.Visible = false
	elseif isCatalog then
		CatalogEmpty.Visible = #catalogResults == 0
		CatalogPackBtn.BackgroundColor3 = catalogKind == "bundle" and C.white or C.btn
		CatalogPackBtn.TextColor3 = catalogKind == "bundle" and C.black or C.txt
		CatalogEmoteBtn.BackgroundColor3 = catalogKind == "emote" and C.white or C.btn
		CatalogEmoteBtn.TextColor3 = catalogKind == "emote" and C.black or C.txt
		if not keepScroll then searchCatalog(false) end
	else
		local pos = Grid.CanvasPosition
		clearCards()
		relayout()
		local source = tab == "emotes" and Config.emotes or tab == "bundles" and Config.packs or Config.favs
		local count = 0
		for _, it in ipairs(source) do
			if state.filter == "" or string.find(string.lower(it.name or ""), state.filter, 1, true) then
				createCard(it).Parent = Grid
				count += 1
			end
		end
		if keepScroll then Grid.CanvasPosition = pos else Grid.CanvasPosition = Vector2.new(0, 0) end
		EmptyLabel.Visible = count == 0
		if count == 0 then
			if state.filter ~= "" then
				EmptyLabel.Text = "No results for that name."
			elseif tab == "emotes" then
				EmptyLabel.Text = "No saved emotes yet.\nPaste an emote ID or link above, or play an emote in your game and press SAVE."
			elseif tab == "bundles" then
				EmptyLabel.Text = "No saved packs yet.\nPaste an animation pack ID or link above and press APPLY, then SAVE."
			else
				EmptyLabel.Text = "No favorites yet. Press the star on any emote or pack."
			end
		end
	end
	setStatus()
end

for key, b in pairs(tabButtons) do
	b.MouseButton1Click:Connect(function() showTab(key) end)
