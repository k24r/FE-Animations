-- Informacion de assets y packs (sin catalogo web)
----------------------------------------------------------------
local animCache = {}
local function resolveAnimId(assetId)
	assetId = tostring(assetId)
	if animCache[assetId] then return animCache[assetId] end
	local result = "rbxassetid://" .. assetId
	pcall(function()
		local objs = game:GetObjects("rbxassetid://" .. assetId)
		local obj = objs and objs[1]
		if obj then
			if obj:IsA("Animation") and obj.AnimationId ~= "" then
				result = obj.AnimationId
			else
				local a = obj:FindFirstChildWhichIsA("Animation", true)
				if a and a.AnimationId ~= "" then result = a.AnimationId end
			end
		end
	end)
	animCache[assetId] = result
	return result
end

local function parseId(text)
	text = tostring(text or "")
	local b = text:match("/bundles/(%d+)")
	if b then return b, true end
	local id = text:match("(%d+)")
	return id, false
end

local function normId(s)
	return s and tostring(s):match("%d+")
end

local function assetInfo(id)
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfo(tonumber(id), Enum.InfoType.Asset)
	end)
	if ok and type(info) == "table" then return info end
end

local function bundleInfo(id)
	local ok, d = pcall(function() return AssetService:GetBundleDetailsAsync(tonumber(id)) end)
	if ok and type(d) == "table" and d.Items then return d end
	local ok2, d2 = pcall(function()
		return MarketplaceService:GetProductInfo(tonumber(id), Enum.InfoType.Bundle)
	end)
	if ok2 and type(d2) == "table" and d2.Items then return d2 end
end

local ANIM_TYPES = { [24] = true, [61] = true }
for t = 48, 56 do ANIM_TYPES[t] = true end

-- Decide si lo pegado es un emote o un pack de animaciones
local function identify(text, tabHint)
	local id, urlBundle = parseId(text)
	if not id then return nil, "Invalid ID or link" end
	if urlBundle then
		local b = bundleInfo(id)
		if b then return { kind = "bundle", id = id, name = b.Name or ("Pack " .. id), info = b } end
		return nil, "Pack not found"
	end
	local catalogUrl = tostring(text):find("/catalog/", 1, true) ~= nil
	local function tryBundle()
		local b = bundleInfo(id)
		if b then return { kind = "bundle", id = id, name = b.Name or ("Pack " .. id), info = b } end
	end
	local function tryAsset()
		local a = assetInfo(id)
		if a then
			if a.AssetTypeId and not ANIM_TYPES[a.AssetTypeId] then return nil, "That ID is not an animation" end
			return { kind = "emote", id = id, name = a.Name or ("Emote " .. id) }
		end
	end
	if tabHint == "bundles" and not catalogUrl then
		local b = tryBundle()
		if b then return b end
		local e, err = tryAsset()
		if e or err then return e, err end
	else
		local e, err = tryAsset()
		if e or err then return e, err end
		if not catalogUrl then
			local b = tryBundle()
			if b then return b end
		end
	end
	return { kind = "emote", id = id, name = "Emote " .. id }
end

