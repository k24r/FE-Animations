	__BA_STATE.catalogResults = {}
	__BA_STATE.CatalogPackBtn.BackgroundColor3 = kind == "bundle" and __BA_STATE.C.white or __BA_STATE.C.btn
	__BA_STATE.CatalogPackBtn.TextColor3 = kind == "bundle" and __BA_STATE.C.black or __BA_STATE.C.txt
	__BA_STATE.CatalogEmoteBtn.BackgroundColor3 = kind == "emote" and __BA_STATE.C.white or __BA_STATE.C.btn
	__BA_STATE.CatalogEmoteBtn.TextColor3 = kind == "emote" and __BA_STATE.C.black or __BA_STATE.C.txt
	if __BA_STATE.state.tab == "catalog" then
		__BA_STATE.SearchBox.PlaceholderText = kind == "bundle" and "Search animation packs..." or "Search emotes..."
		__BA_STATE.searchCatalog(false)
	end
end

__BA_STATE.searchCatalog = function(append)
	if append and __BA_STATE.catalogBusy then return end

	local keyword = (__BA_STATE.SearchBox.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if not append then
		__BA_STATE.catalogPages = nil
		__BA_STATE.catalogResults = {}
		__BA_STATE.clearCatalogCards()
	elseif not __BA_STATE.catalogPages then
		return
	end

	__BA_STATE.catalogBusy = true
	__BA_STATE.catalogToken += 1
	local token = __BA_STATE.catalogToken
	__BA_STATE.CatalogEmpty.Visible = false
	__BA_STATE.CatalogMoreBtn.Visible = false
	__BA_STATE.notify("Searching Roblox catalog with AvatarEditorService...")

	task.spawn(function()
		local ok, pageData = pcall(function()
			local AvatarEditorService = game:GetService("AvatarEditorService")

			if append then
				if __BA_STATE.catalogPages.IsFinished then
					return {}
				end
				__BA_STATE.catalogPages:AdvanceToNextPageAsync()
			else
				local params = __BA_STATE.makeCatalogSearchParams(keyword)
				__BA_STATE.catalogPages = AvatarEditorService:SearchCatalogAsync(params)
			end

			return __BA_STATE.catalogPages:GetCurrentPage()
		end)

		if token ~= __BA_STATE.catalogToken then return end
		__BA_STATE.catalogBusy = false

		if not ok or type(pageData) ~= "table" then
			local message = tostring(pageData or "Unknown AvatarEditorService error")
			__BA_STATE.CatalogEmpty.Text = "AvatarEditorService search failed:\n" .. message
			__BA_STATE.CatalogEmpty.Visible = true
			__BA_STATE.CatalogMoreBtn.Visible = false
			__BA_STATE.notify("Catalog search failed • see error above")
			return
		end

		for _, result in ipairs(pageData) do
			local id = result.Id or result.id
			if id then
				local item = {
					kind = __BA_STATE.catalogKind,
					id = tostring(id),
					name = result.Name or result.name
						or ((__BA_STATE.catalogKind == "bundle" and "Animation pack " or "Emote ") .. tostring(id)),
					img = ("rbxthumb://type=%s&id=%s&w=150&h=150"):format(
						__BA_STATE.catalogKind == "bundle" and "BundleThumbnail" or "Asset",
						tostring(id)
					),
				}
				table.insert(__BA_STATE.catalogResults, item)
				__BA_STATE.createCatalogCard(item)
			end
		end

		local hasMore = false
		pcall(function()
			hasMore = __BA_STATE.catalogPages ~= nil and not __BA_STATE.catalogPages.IsFinished
		end)
		__BA_STATE.CatalogMoreBtn.Visible = hasMore
		__BA_STATE.CatalogEmpty.Visible = #__BA_STATE.catalogResults == 0
		if #__BA_STATE.catalogResults == 0 then
			__BA_STATE.CatalogEmpty.Text = keyword == ""
				and "No catalog items found in this category."
				or "No results. Try another search."
		end
		if not append then
			__BA_STATE.CatalogGrid.CanvasPosition = Vector2.new(0, 0)
		end
		__BA_STATE.setStatus((__BA_STATE.catalogKind == "bundle" and "Animation packs" or "Emotes")
			.. ": " .. tostring(#__BA_STATE.catalogResults) .. " results")
	end)
end

__BA_STATE.CatalogPackBtn.MouseButton1Click:Connect(function() __BA_STATE.setCatalogKind("bundle") end)
__BA_STATE.CatalogEmoteBtn.MouseButton1Click:Connect(function() __BA_STATE.setCatalogKind("emote") end)
