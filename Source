function __BA_STATE.relayout()
	local W = __BA_STATE.Grid.AbsoluteSize.X - 8
	local cols = math.max(1, math.floor((W + 8) / 158))
	local cellW = math.floor((W - (cols - 1) * 8) / cols)
	__BA_STATE.GridLayout.CellSize = UDim2.fromOffset(cellW, math.floor(cellW * 0.82) + 46)
end
__BA_STATE.connect(__BA_STATE.Grid:GetPropertyChangedSignal("AbsoluteSize"), __BA_STATE.relayout)
__BA_STATE.connect(__BA_STATE.Main:GetPropertyChangedSignal("AbsoluteSize"), function()
	task.defer(__BA_STATE.relayout)
	task.defer(__BA_STATE.relayoutCatalog)
end)

