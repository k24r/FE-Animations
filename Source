pClose.MouseButton1Click:Connect(function() Preview.Visible = false; previewToken += 1 end)
pSave.MouseButton1Click:Connect(function()
	if not previewItem or libIndex(previewItem) then return end
	previewToken += 1 -- cancela el cierre automatico
	currentPreviewName()
	saveItem(previewItem, false)
	notify("Saved: " .. previewItem.name)
	Preview.Visible = false
end)
pFav.MouseButton1Click:Connect(function()
	if not previewItem then return end
	previewToken += 1
	local fi = favIndex(previewItem)
	if fi then
		table.remove(Config.favs, fi)
		save()
		refreshPreviewButtons()
		if state.tab == "favs" then showTab(nil) end
	else
		currentPreviewName()
		saveItem(previewItem, true)
		notify("Saved to favorites: " .. previewItem.name)
		Preview.Visible = false
	end
end)
pName.FocusLost:Connect(function()
	if not previewItem then return end
	previewToken += 1
	local nm = currentPreviewName()
	local i = libIndex(previewItem)
	if i then libList(previewItem.kind)[i].name = nm end
	local fi = favIndex(previewItem)
	if fi then Config.favs[fi].name = nm end
	if i or fi then
		save()
		showTab(nil)
	end
end)

