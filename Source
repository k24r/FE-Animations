			local y = math.clamp(__BA_STATE.floatingStartPos.Y + delta.Y, 0, math.max(0, viewport.Y - __BA_STATE.FloatingK24.AbsoluteSize.Y))
			__BA_STATE.FloatingK24.Position = UDim2.fromOffset(x, y)
