	}, card)
	local saveBtn = makeButton({ Text = libIndex(item) and "SAVED ✓" or "SAVE", Position = UDim2.new(0, 6, 1, -62), Size = UDim2.new(0.32, -5, 0, 24), TextSize = 9 }, card)
	local profileBtn = makeButton({ Text = "💾", Position = UDim2.new(0.34, 0, 1, -62), Size = UDim2.new(0.34, -4, 0, 24), TextSize = 12 }, card)
	local favBtn = makeButton({ Text = favIndex(item) and "★" or "☆", Position = UDim2.new(0.70, 0, 1, -62), Size = UDim2.new(0.30, -6, 0, 24), TextSize = 14, TextColor3 = favIndex(item) and C.gold or C.txt }, card)
	local useBtn = makeButton({ Text = item.kind == "bundle" and "APPLY" or "PLAY", Position = UDim2.new(0, 6, 1, -32), Size = UDim2.new(1, -12, 0, 26), TextSize = 11, BackgroundColor3 = C.white, TextColor3 = C.black }, card)
	saveBtn.MouseButton1Click:Connect(function()
		if libIndex(item) then
