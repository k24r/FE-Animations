		local load = __BA_STATE.makeButton({
			Text = "LOAD", Position = UDim2.new(1, -214, 0, 8),
			Size = UDim2.fromOffset(62, 32),
			BackgroundColor3 = isActive and __BA_STATE.C.white or __BA_STATE.C.btn,
			TextColor3 = isActive and __BA_STATE.C.black or __BA_STATE.C.txt,
		}, row)
		local update = __BA_STATE.makeButton({
			Text = "UPDATE", Position = UDim2.new(1, -146, 0, 8),
			Size = UDim2.fromOffset(70, 32),
		}, row)
		local delete = __BA_STATE.makeButton({
			Text = "✕", Position = UDim2.new(1, -70, 0, 8),
			Size = UDim2.fromOffset(60, 32),
			TextColor3 = Color3.fromRGB(255, 120, 120),
		}, row)

		load.MouseButton1Click:Connect(function()
			__BA_STATE.Config.hotkeys = __BA_STATE.copyHotkeys(profile.hotkeys)
			__BA_STATE.Config.activeProfile = profile.name
			__BA_STATE.save()
			if __BA_STATE.state.tab == "profiles" then __BA_STATE.renderProfiles() end
			__BA_STATE.refreshPreviewButtons()
			__BA_STATE.notify("Profile loaded: " .. profile.name)
		end)

		update.MouseButton1Click:Connect(function()
			profile.hotkeys = __BA_STATE.copyHotkeys(__BA_STATE.Config.hotkeys)
			__BA_STATE.Config.activeProfile = profile.name
			__BA_STATE.save()
			__BA_STATE.renderProfiles()
			__BA_STATE.notify("Profile updated: " .. profile.name)
		end)

		delete.MouseButton1Click:Connect(function()
			local removeIndex = __BA_STATE.findProfile(profile.name)
			if removeIndex then table.remove(__BA_STATE.Config.profiles, removeIndex) end
			if __BA_STATE.Config.activeProfile == profile.name then __BA_STATE.Config.activeProfile = "" end
			__BA_STATE.save()
			__BA_STATE.renderProfiles()
			__BA_STATE.notify("Profile deleted: " .. profile.name)
		end)
	end

	if #__BA_STATE.Config.profiles == 0 then
		local empty = __BA_STATE.new("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 54),
			Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = __BA_STATE.C.dim,
