			Size = UDim2.new(1, -230, 1, 0),
			Font = Enum.Font.GothamBold, TextSize = 12,
			TextColor3 = isActive and __BA_STATE.C.gold or __BA_STATE.C.txt,
			TextXAlignment = Enum.TextXAlignment.Left,
