local function doApplyId()
	local text = IdBox.Text
	if text:gsub("%s", "") == "" then return end
	notify("Looking up...")
	task.spawn(function()
		local item, err = identify(text, state.tab)
		if not item then notify(err or "Invalid ID or link"); return end
		if item.kind == "bundle" then
			applyBundle(item, false)
		else
			playEmote(item.id, item.name, false)
		end
	end)
end
