local function setCatalogKind(kind)
	catalogKind = kind
	catalogBusy = false
	catalogToken += 1
	catalogPages = nil
	catalogResults = {}
	CatalogPackBtn.BackgroundColor3 = kind == "bundle" and C.white or C.btn
	CatalogPackBtn.TextColor3 = kind == "bundle" and C.black or C.txt
	CatalogEmoteBtn.BackgroundColor3 = kind == "emote" and C.white or C.btn
	CatalogEmoteBtn.TextColor3 = kind == "emote" and C.black or C.txt
	if state.tab == "catalog" then
		SearchBox.PlaceholderText = kind == "bundle" and "Search animation packs..." or "Search emotes..."
		searchCatalog(false)
	end
end

searchCatalog = function(append)
	if append and catalogBusy then return end

	local keyword = (SearchBox.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if not append then
		catalogPages = nil
		catalogResults = {}
		clearCatalogCards()
	elseif not catalogPages then
		return
	end

	catalogBusy = true
	catalogToken += 1
	local token = catalogToken
	CatalogEmpty.Visible = false
	CatalogMoreBtn.Visible = false
	notify("Searching Roblox catalog with AvatarEditorService...")

	task.spawn(function()
		local ok, pageData = pcall(function()
			local AvatarEditorService = game:GetService("AvatarEditorService")

			if append then
				if catalogPages.IsFinished then
					return {}
				end
				catalogPages:AdvanceToNextPageAsync()
			else
				local params = makeCatalogSearchParams(keyword)
				catalogPages = AvatarEditorService:SearchCatalogAsync(params)
			end

			return catalogPages:GetCurrentPage()
		end)

		if token ~= catalogToken then return end
		catalogBusy = false

		if not ok or type(pageData) ~= "table" then
			local message = tostring(pageData or "Unknown AvatarEditorService error")
			CatalogEmpty.Text = "AvatarEditorService search failed:\n" .. message
			CatalogEmpty.Visible = true
			CatalogMoreBtn.Visible = false
			notify("Catalog search failed • see error above")
			return
		end

		for _, result in ipairs(pageData) do
			local id = result.Id or result.id
			if id then
				local item = {
					kind = catalogKind,
					id = tostring(id),
					name = result.Name or result.name
						or ((catalogKind == "bundle" and "Animation pack " or "Emote ") .. tostring(id)),
					img = ("rbxthumb://type=%s&id=%s&w=150&h=150"):format(
						catalogKind == "bundle" and "BundleThumbnail" or "Asset",
						tostring(id)
					),
				}
				table.insert(catalogResults, item)
				createCatalogCard(item)
			end
		end

		local hasMore = false
		pcall(function()
			hasMore = catalogPages ~= nil and not catalogPages.IsFinished
		end)
		CatalogMoreBtn.Visible = hasMore
		CatalogEmpty.Visible = #catalogResults == 0
		if #catalogResults == 0 then
			CatalogEmpty.Text = keyword == ""
				and "No catalog items found in this category."
				or "No results. Try another search."
		end
		if not append then
			CatalogGrid.CanvasPosition = Vector2.new(0, 0)
		end
		setStatus((catalogKind == "bundle" and "Animation packs" or "Emotes")
			.. ": " .. tostring(#catalogResults) .. " results")
	end)
end

CatalogPackBtn.MouseButton1Click:Connect(function() setCatalogKind("bundle") end)
CatalogEmoteBtn.MouseButton1Click:Connect(function() setCatalogKind("emote") end)
CatalogMoreBtn.MouseButton1Click:Connect(function()
	if catalogPages and not catalogPages.IsFinished then searchCatalog(true) end
end)

local function updateTabStyle()
