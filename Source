function __BA_STATE.doApplyId()
	local text = __BA_STATE.IdBox.Text
	if text:gsub("%s", "") == "" then return end
	__BA_STATE.notify("Looking up...")
	task.spawn(function()
		local item, err = __BA_STATE.identify(text, __BA_STATE.state.tab)
		if not item then __BA_STATE.notify(err or "Invalid ID or link"); return end
		if item.kind == "bundle" then
			__BA_STATE.applyBundle(item, false)
		else
			__BA_STATE.playEmote(item.id, item.name, false)
		end
	end)
