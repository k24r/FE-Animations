function __BA_STATE.refreshSpeedUI()
	local v = __BA_STATE.Config.speed
	local r = (v - __BA_STATE.MIN_S) / (__BA_STATE.MAX_S - __BA_STATE.MIN_S)
	__BA_STATE.fill.Size = UDim2.fromScale(r, 1)
	__BA_STATE.knob.Position = UDim2.fromScale(r, 0.5)
	__BA_STATE.speedLabel.Text = ("%.2fx"):format(v)
	for val, b in pairs(__BA_STATE.presetBtns) do
		local on = math.abs(val - v) < 0.005
		b.BackgroundColor3 = on and __BA_STATE.C.white or __BA_STATE.C.btn
		b.TextColor3 = on and __BA_STATE.C.black or __BA_STATE.C.txt
	end
end
function __BA_STATE.setSpeed(v)
