__BA_STATE.statusToken = 0
function __BA_STATE.defaultStatus()
	if __BA_STATE.state.tab == "emotes" then
		return ("Saved emotes: %d  •  paste an ID or play an emote to add more"):format(#__BA_STATE.Config.emotes)
	elseif __BA_STATE.state.tab == "bundles" then
		return ("Saved packs: %d  •  paste a pack ID or link to add more"):format(#__BA_STATE.Config.packs)
	elseif __BA_STATE.state.tab == "favs" then
		return ("Favorites: %d"):format(#__BA_STATE.Config.favs)
	elseif __BA_STATE.state.tab == "profiles" then
		return ("Saved profiles: %d  •  active: %s"):format(#__BA_STATE.Config.profiles, __BA_STATE.Config.activeProfile ~= "" and __BA_STATE.Config.activeProfile or "none")
	elseif __BA_STATE.state.tab == "catalog" then
		return __BA_STATE.catalogKind == "bundle" and "Roblox catalog • Animation packs" or "Roblox catalog • Emotes"
	end
	return "Type an ID or link for each slot and press Enter"
end
function __BA_STATE.setStatus(text) Status.Text = text or defaultStatus() end
__BA_STATE.notify = function(text)
	__BA_STATE.statusToken += 1
	local t = __BA_STATE.statusToken
	__BA_STATE.Status.Text = tostring(text)
	task.delay(2.5, function()
		if t == __BA_STATE.statusToken then __BA_STATE.setStatus() end
	end)
end

function __BA_STATE.mouseInside(obj)
	local m = __BA_STATE.UIS:GetMouseLocation()
	local p, s = obj.AbsolutePosition, obj.AbsoluteSize
	return m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y and m.Y <= p.Y + s.Y
end

