function __BA_STATE.createProfile()
	local name = (__BA_STATE.profileNameBox.Text:gsub("^%s+", ""):gsub("%s+$", ""))
	if name == "" then
		__BA_STATE.notify("Enter a profile name first")
		return
	end
	local _, existing = __BA_STATE.findProfile(name)
	if existing then
		__BA_STATE.notify("That profile already exists. Use UPDATE on its row.")
		return
	end
	table.insert(__BA_STATE.Config.profiles, {
		name = name,
		hotkeys = __BA_STATE.copyHotkeys(__BA_STATE.Config.hotkeys),
	})
	__BA_STATE.Config.activeProfile = name
	__BA_STATE.profileNameBox.Text = ""
	__BA_STATE.save()
	__BA_STATE.renderProfiles()
	__BA_STATE.notify("Profile saved: " .. name)
end
