-- Busqueda del catalogo mediante AvatarEditorService
-- Usa la API oficial del cliente de Roblox; no realiza peticiones HTTP externas.
----------------------------------------------------------------
local catalogPages = nil
local catalogBusy = false
local catalogToken = 0
local catalogResults = {}
local searchCatalog

local function clearCatalogCards()
