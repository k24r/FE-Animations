local Char, Hum, Animator
local function refreshChar()
	Char = LP.Character
	Hum = Char and Char:FindFirstChildOfClass("Humanoid")
	Animator = Hum and Hum:FindFirstChildWhichIsA("Animator", true)
	return Animator ~= nil
end
refreshChar()

local notify, showPreview, showTab, refreshPreviewButtons -- se definen mas abajo

local ourTracks = setmetatable({}, { __mode = "k" }) -- tracks creados por este script
local emote = { track = nil, id = nil, token = 0, startedAt = 0 }
local clickImg = { image = nil, t = 0 } -- ultima imagen clickeada en la GUI del juego

-- IDs de animacion que usa el script Animate (idle, walk, run...)
local function animateIdSet()
	local set = {}
	local an = Char and Char:FindFirstChild("Animate")
	if an then
		for _, d in ipairs(an:GetDescendants()) do
			if d:IsA("Animation") then
				local n = normId(d.AnimationId)
				if n then set[n] = true end
			end
		end
	end
	return set
end

-- Un "emote del juego" = animacion de prioridad Action que no viene de Animate
local function isGameEmoteTrack(t, set)
	local pr = t.Priority.Value
	if pr < 2 or pr > 5 then return false end
	local anim = t.Animation
	local id = anim and normId(anim.AnimationId)
	return id ~= nil and not set[id]
end

local function stopGameEmotes()
	if not Animator then return end
	local set = animateIdSet()
	for _, t in ipairs(Animator:GetPlayingAnimationTracks()) do
		if not ourTracks[t] and isGameEmoteTrack(t, set) then
			pcall(function() t:Stop(0.1) end)
		end
	end
end

local function stopEmote(fade)
	emote.token += 1
	if emote.track then
		pcall(function() emote.track:Stop(fade or 0.2) end)
	end
	emote.track = nil
	emote.id = nil
end

-- Reproduce un emote.
-- Si presionas el mismo emote mientras está reproduciéndose, lo detiene.
-- Si eliges otro emote, detiene el anterior y reproduce el nuevo.
local function playEmote(id, name, silent, img)
	id = tostring(id)

	if not refreshChar() then
		notify("No character / Animator found")
		return
	end

	-- Si este mismo emote ya está reproduciéndose, detenerlo.
	if emote.id == id and emote.track and emote.track.IsPlaying then
		stopEmote(0.2)

		if not silent then
			notify("Emote stopped: " .. tostring(name))
		end

		return
	end

	-- Si es otro emote, detener el anterior antes de reproducir el nuevo.
	stopEmote(0)
	stopGameEmotes()
	local token = emote.token
	emote.id = id
	task.spawn(function()
		local animId = resolveAnimId(id)
		if token ~= emote.token then return end
		local a = Instance.new("Animation")
		a.AnimationId = animId
		local ok, track = pcall(function() return Animator:LoadAnimation(a) end)
		if not ok or not track then
			emote.id = nil
			notify("Could not load emote")
			return
		end
		ourTracks[track] = true
		track.Priority = Enum.AnimationPriority.Action4
		track:Play(0.1, 1, Config.speed)
		track.TimePosition = 0
		emote.track = track
		emote.startedAt = os.clock()
		track.Stopped:Connect(function()
			if emote.track == track then emote.track = nil; emote.id = nil end
		end)
		notify("Emote: " .. tostring(name))
		if not silent then
			showPreview({ kind = "emote", id = id, name = name, img = img }, "NOW PLAYING")
		end
	end)
end

local SLOT_ORDER = { "idle", "walk", "run", "jump", "fall", "climb", "swim" }
local SLOT_PATHS = {
	idle = { { "idle", "Animation1" }, { "idle", "Animation2" } },
	walk = { { "walk", "WalkAnim" } },
	run = { { "run", "RunAnim" } },
	jump = { { "jump", "JumpAnim" } },
	fall = { { "fall", "FallAnim" } },
	climb = { { "climb", "ClimbAnim" } },
	swim = { { "swim", "Swim" } },
}

local original = {}
local currentSlots = {}

local function setAnimateDisabled(animate, v)
	pcall(function() animate.Disabled = v end)
	pcall(function() animate.Enabled = not v end)
end

local function writeSlots(animate)
	for slot, id in pairs(currentSlots) do
		for _, p in ipairs(SLOT_PATHS[slot] or {}) do
			local f = animate:FindFirstChild(p[1])
			local v = f and f:FindFirstChild(p[2])
			if v then
				local key = p[1] .. "." .. p[2]
				if original[key] == nil then original[key] = v.AnimationId end
				v.AnimationId = id
			end
		end
	end
end

local function restartAnimate(animate)
	setAnimateDisabled(animate, true)
	if Animator then
		for _, t in ipairs(Animator:GetPlayingAnimationTracks()) do
			if t ~= emote.track then pcall(function() t:Stop(0) end) end
		end
	end
	task.wait()
	setAnimateDisabled(animate, false)
end

local function applySlots(slots)
	refreshChar()
	local animate = Char and Char:FindFirstChild("Animate")
	if not animate then
		notify("No 'Animate' script found in your character")
		return false
	end
	for s, id in pairs(slots) do currentSlots[s] = id end
	writeSlots(animate)
	restartAnimate(animate)
	return true
end

local function slotsFromInfo(info)
	local slots = {}
	for _, it in ipairs(info.Items or {}) do
		local iid = it.Id or it.id
		local itype = it.Type or it.type
		if itype == "Asset" and iid then
			local n = string.lower(it.Name or it.name or "")
			for _, s in ipairs(SLOT_ORDER) do
				if n:find(s, 1, true) then
					if not slots[s] then slots[s] = resolveAnimId(iid) end
					break
				end
			end
		end
	end
	return slots
end

local function applyBundle(item, silent)
	task.spawn(function()
		notify("Applying pack...")
		local info = item.info or bundleInfo(item.id)
		if not info then
			notify("Could not read pack " .. tostring(item.id))
			return
		end
		local slots = slotsFromInfo(info)
		if next(slots) == nil then
			notify("That pack has no walk/run/idle animations")
			return
		end
		if applySlots(slots) then
			notify("Pack: " .. tostring(item.name))
			if not silent then
				local names = {}
				for _, s in ipairs(SLOT_ORDER) do
					if slots[s] then table.insert(names, s) end
				end
				showPreview({ kind = "bundle", id = tostring(item.id), name = item.name }, "PACK APPLIED", table.concat(names, ", "))
			end
		end
	end)
end

local function resetAnimations()
	stopEmote()
	refreshChar()
	local animate = Char and Char:FindFirstChild("Animate")
	currentSlots = {}
	if animate then
		for key, id in pairs(original) do
			local f, n = key:match("([^.]+)%.(.+)")
			local folder = f and animate:FindFirstChild(f)
			local v = folder and folder:FindFirstChild(n)
			if v then v.AnimationId = id end
		end
		original = {}
		task.spawn(restartAnimate, animate)
	end
	notify("Animations reset")
end

connect(LP.CharacterAdded, function(c)
	original = {}
	emote.track = nil
	emote.id = nil
	task.spawn(function()
		c:WaitForChild("Humanoid", 10)
		c:WaitForChild("Animate", 10)
		task.wait(0.6)
		refreshChar()
		if next(currentSlots) then applySlots({}) end
	end)
end)

----------------------------------------------------------------
-- Biblioteca (guardados) y favoritos
----------------------------------------------------------------
local function libList(kind) return kind == "bundle" and Config.packs or Config.emotes end
local function libIndex(item)
	for i, v in ipairs(libList(item.kind)) do
		if tostring(v.id) == tostring(item.id) then return i end
	end
end
local function favIndex(item)
	for i, f in ipairs(Config.favs) do
		if f.kind == item.kind and tostring(f.id) == tostring(item.id) then return i end
	end
end
local function hkKey(item) return item.kind .. ":" .. tostring(item.id) end

-- Copia independiente de los atajos para que cada perfil tenga su propio mapa.
local function copyHotkeys(source)
	local result = {}
	for key, value in pairs(source or {}) do
		if type(value) == "table" then
			result[key] = {
				kind = value.kind,
				id = tostring(value.id or ""),
				name = value.name or "",
				key = value.key,
			}
		end
	end
	return result
end

local function findProfile(name)
	local wanted = string.lower((tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")))
	for index, profile in ipairs(Config.profiles) do
		if string.lower(profile.name or "") == wanted then
			return index, profile
		end
	end
end

local function collectionProfiles(kind)
	return kind == "bundle" and Config.packProfiles or Config.emoteProfiles
end

local function findCollectionFolder(kind, name)
	local wanted = string.lower((tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")))
	for index, folder in ipairs(collectionProfiles(kind)) do
		if string.lower(folder.name or "") == wanted then return index, folder end
	end
end

local function addItemToCollection(kind, folderName, item)
	local _, folder = findCollectionFolder(kind, folderName)
	if not folder then return false end
	folder.items = folder.items or {}
	for _, saved in ipairs(folder.items) do
		if tostring(saved.id) == tostring(item.id) then return true end
	end
	table.insert(folder.items, { kind = kind, id = tostring(item.id), name = item.name or ((kind == "bundle" and "Pack " or "Emote ") .. tostring(item.id)), img = item.img })
	save()
	return true
end

local function copyMixSlots(source)
	local result = {}
	for _, slot in ipairs(SLOT_ORDER) do
		if source and source[slot] and tostring(source[slot]) ~= "" then result[slot] = tostring(source[slot]) end
	end
	return result
end

local function syncActiveProfile()
	if Config.activeProfile == "" then return end
	local _, profile = findProfile(Config.activeProfile)
	if profile then
		profile.hotkeys = copyHotkeys(Config.hotkeys)
	end
end

local function saveItem(item, fav)
	local name = (item.name and item.name ~= "") and item.name or ((item.kind == "bundle" and "Pack " or "Emote ") .. tostring(item.id))
	local entry = { kind = item.kind, id = tostring(item.id), name = name, img = item.img }
	if not libIndex(entry) then table.insert(libList(entry.kind), entry) end
	if fav and not favIndex(entry) then
		table.insert(Config.favs, { kind = entry.kind, id = entry.id, name = entry.name, img = entry.img })
	end
	save()
	refreshPreviewButtons()
	showTab(nil)
end

local function removeItem(item)
	local list = libList(item.kind)
	local i = libIndex(item)
	if i then table.remove(list, i) end
	local fi = favIndex(item)
	if fi then table.remove(Config.favs, fi) end
	Config.hotkeys[hkKey(item)] = nil
	syncActiveProfile()
	save()
	refreshPreviewButtons()
	showTab(nil)
end

local function activate(item)
	if item.kind == "bundle" then
		applyBundle({ kind = "bundle", id = item.id, name = item.name }, true)
	else
		playEmote(item.id, item.name, true)
	end
end

----------------------------------------------------------------
-- Velocidad, cancelar emote al moverse, deteccion de emotes del juego
----------------------------------------------------------------
local prevPlaying = {}
local function detectEmotes()
	if not Animator then return end
	local cur = {}
	local animateSet
	for _, t in ipairs(Animator:GetPlayingAnimationTracks()) do
		cur[t] = true
		-- solo cuenta cuando una animacion EMPIEZA (asi se detecta cada vez que se repite)
		if not prevPlaying[t] and not ourTracks[t] then
			animateSet = animateSet or animateIdSet()
			if not (Char and Char:FindFirstChildOfClass("Tool")) and isGameEmoteTrack(t, animateSet) then
				-- el juego empezo un emote: se corta el nuestro para no mezclar dos
				if emote.track then stopEmote(0.1) end
				local id = normId(t.Animation.AnimationId)
				if Config.detect and id and not libIndex({ kind = "emote", id = id }) then
					local img = (clickImg.image and os.clock() - clickImg.t < 2.5) and clickImg.image or nil
					task.spawn(function()
						local info = assetInfo(id)
						local name = info and info.Name or ("Emote " .. id)
						if not img and info and info.IconImageAssetId and info.IconImageAssetId ~= 0 then
							img = "rbxassetid://" .. tostring(info.IconImageAssetId)
						end
						showPreview({ kind = "emote", id = id, name = name, img = img }, "EMOTE DETECTED", nil, 25)
					end)
				end
			end
		end
	end
	prevPlaying = cur
end

local speedModified = false
local lastCheck = 0
connect(RunService.Heartbeat, function()
	if not Animator or not Animator.Parent then refreshChar() end
	if emote.track then
		pcall(function() emote.track:AdjustSpeed(Config.speed) end)
		if not Config.keepEmote and Hum and os.clock() - emote.startedAt > 0.35 then
			local st = Hum:GetState()
			if Hum.MoveDirection.Magnitude > 0.1 or st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall then
				stopEmote()
			end
		end
	elseif Animator then
		if math.abs(Config.speed - 1) > 0.001 then
			speedModified = true
			for _, t in ipairs(Animator:GetPlayingAnimationTracks()) do
				pcall(function() t:AdjustSpeed(Config.speed) end)
			end
		elseif speedModified then
			speedModified = false
			for _, t in ipairs(Animator:GetPlayingAnimationTracks()) do
				pcall(function() t:AdjustSpeed(1) end)
			end
		end
	end
	if os.clock() - lastCheck > 0.15 then
		lastCheck = os.clock()
		pcall(detectEmotes)
	end
end)

