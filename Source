function __BA_STATE.createCollectionFolder(kind, box)
	local name = (box.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if name == "" then __BA_STATE.notify("Enter a folder name first"); return end
	if __BA_STATE.findCollectionFolder(kind, name) then __BA_STATE.notify("A folder with that name already exists"); return end
	table.insert(__BA_STATE.collectionProfiles(kind), { name = name, items = {} })
	box.Text = ""; __BA_STATE.save(); __BA_STATE.renderCollectionFolders(kind); __BA_STATE.notify("Folder created: " .. name)
end
__BA_STATE.emoteFolderAdd.MouseButton1Click:Connect(function() __BA_STATE.createCollectionFolder("emote", __BA_STATE.emoteFolderBox) end)
__BA_STATE.packFolderAdd.MouseButton1Click:Connect(function() __BA_STATE.createCollectionFolder("bundle", __BA_STATE.packFolderBox) end)

