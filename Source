function __BA_STATE.updateTabStyle()
	for key, b in pairs(__BA_STATE.tabButtons) do
		local on = key == __BA_STATE.state.tab
		b.BackgroundColor3 = on and __BA_STATE.C.white or __BA_STATE.C.btn
		b.TextColor3 = on and __BA_STATE.C.black or __BA_STATE.C.txt
	end
end

-- showTab(nil) vuelve a dibujar la pestana actual
__BA_STATE.showTab = function(tab)
	local keepScroll = tab == nil
	tab = tab or __BA_STATE.state.tab
	if tab ~= __BA_STATE.state.tab then __BA_STATE.state.filter = ""; __BA_STATE.SearchBox.Text = "" end
	__BA_STATE.state.tab = tab
	__BA_STATE.updateTabStyle()
	local isMix = tab == "mix"
	local isProfiles = tab == "profiles"
	local isCatalog = tab == "catalog"
	__BA_STATE.Grid.Visible = not isMix and not isProfiles and not isCatalog
	__BA_STATE.MixPage.Visible = isMix
	__BA_STATE.ProfilePage.Visible = isProfiles
	__BA_STATE.CatalogPage.Visible = isCatalog
	__BA_STATE.SearchBox.Visible = not isProfiles and not isMix
	__BA_STATE.SearchBtn.Visible = not isProfiles and not isMix
	__BA_STATE.IdBox.Visible = not isProfiles and not isMix and not isCatalog
	__BA_STATE.ApplyBtn.Visible = not isProfiles and not isMix and not isCatalog
	__BA_STATE.EmptyLabel.Visible = false
	__BA_STATE.SearchBox.PlaceholderText = isCatalog and (__BA_STATE.catalogKind == "bundle" and "Search animation packs..." or "Search emotes...") or (tab == "favs" and "Name" or "Zombie, Cute")
	__BA_STATE.IdBox.PlaceholderText = "Url or ID"
	if isProfiles then
		__BA_STATE.setProfileMode(__BA_STATE.profileMode)
		if __BA_STATE.profileMode == "hotkeys" then __BA_STATE.renderProfiles() elseif __BA_STATE.profileMode == "emotes" then __BA_STATE.renderCollectionFolders("emote") elseif __BA_STATE.profileMode == "packs" then __BA_STATE.renderCollectionFolders("bundle") else __BA_STATE.renderMixProfiles() end
	elseif isMix then
		__BA_STATE.EmptyLabel.Visible = false
	elseif isCatalog then
		__BA_STATE.CatalogEmpty.Visible = #__BA_STATE.catalogResults == 0
		__BA_STATE.CatalogPackBtn.BackgroundColor3 = __BA_STATE.catalogKind == "bundle" and __BA_STATE.C.white or __BA_STATE.C.btn
		__BA_STATE.CatalogPackBtn.TextColor3 = __BA_STATE.catalogKind == "bundle" and __BA_STATE.C.black or __BA_STATE.C.txt
		__BA_STATE.CatalogEmoteBtn.BackgroundColor3 = __BA_STATE.catalogKind == "emote" and __BA_STATE.C.white or __BA_STATE.C.btn
		__BA_STATE.CatalogEmoteBtn.TextColor3 = __BA_STATE.catalogKind == "emote" and __BA_STATE.C.black or __BA_STATE.C.txt
		if not keepScroll then __BA_STATE.searchCatalog(false) end
	else
		local pos = __BA_STATE.Grid.CanvasPosition
		__BA_STATE.clearCards()
		__BA_STATE.relayout()
		local source = tab == "emotes" and __BA_STATE.Config.emotes or tab == "bundles" and __BA_STATE.Config.packs or __BA_STATE.Config.favs
		local count = 0
		for _, it in ipairs(source) do
			if __BA_STATE.state.filter == "" or string.find(string.lower(it.name or ""), __BA_STATE.state.filter, 1, true) then
				__BA_STATE.createCard(it).Parent = __BA_STATE.Grid
				count += 1
			end
		end
		if keepScroll then __BA_STATE.Grid.CanvasPosition = pos else __BA_STATE.Grid.CanvasPosition = Vector2.new(0, 0) end
		__BA_STATE.EmptyLabel.Visible = count == 0
		if count == 0 then
			if __BA_STATE.state.filter ~= "" then
				__BA_STATE.EmptyLabel.Text = "No results for that name."
			elseif tab == "emotes" then
				__BA_STATE.EmptyLabel.Text = "No saved emotes yet.\nPaste an emote ID or link above, or play an emote in your game and press SAVE."
			elseif tab == "bundles" then
				__BA_STATE.EmptyLabel.Text = "No saved packs yet.\nPaste an animation pack ID or link above and press APPLY, then SAVE."
			else
				__BA_STATE.EmptyLabel.Text = "No favorites yet. Press the star on any emote or pack."
			end
		end
	end
	__BA_STATE.setStatus()
end

for key, b in pairs(__BA_STATE.tabButtons) do
	b.MouseButton1Click:Connect(function() __BA_STATE.showTab(key) end)
