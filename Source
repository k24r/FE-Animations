	del.MouseButton1Click:Connect(function() __BA_STATE.removeItem(item) end)
	edit.MouseButton1Click:Connect(function() if __BA_STATE.openRenameItem then __BA_STATE.openRenameItem(item) end end)
	profileSave.MouseButton1Click:Connect(function() if __BA_STATE.openProfilePicker then __BA_STATE.openProfilePicker(item) end end)
	hk.MouseButton1Click:Connect(function()
		hk.Text = "..."
		hk.TextColor3 = __BA_STATE.C.white
		__BA_STATE.capture = function(kc)
			if kc == Enum.KeyCode.Escape then
				__BA_STATE.Config.hotkeys[__BA_STATE.hkKey(item)] = nil
			else
				__BA_STATE.Config.hotkeys[__BA_STATE.hkKey(item)] = { kind = item.kind, id = item.id, name = item.name, key = kc.Name }
			end
			__BA_STATE.syncActiveProfile()
			__BA_STATE.save()
			if hk.Parent then refreshHK() end
		end
	end)

	return card
