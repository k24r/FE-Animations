local state = { tab = "emotes", cardOrder = 0, filter = "" }

local statusToken = 0
local function defaultStatus()
	if state.tab == "emotes" then
		return ("Saved emotes: %d  •  paste an ID or play an emote to add more"):format(#Config.emotes)
	elseif state.tab == "bundles" then
		return ("Saved packs: %d  •  paste a pack ID or link to add more"):format(#Config.packs)
	elseif state.tab == "favs" then
		return ("Favorites: %d"):format(#Config.favs)
	end
	return "Type an ID or link for each slot and press Enter"
end
local function setStatus(text) Status.Text = text or defaultStatus() end
notify = function(text)
	statusToken += 1
	local t = statusToken
	Status.Text = tostring(text)
	task.delay(2.5, function()
		if t == statusToken then setStatus() end
	end)
end

local function mouseInside(obj)
	local m = UIS:GetMouseLocation()
	local p, s = obj.AbsolutePosition, obj.AbsoluteSize
	return m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y and m.Y <= p.Y + s.Y
end

local function createCard(item)
	state.cardOrder += 1
	local card = new("Frame", { BackgroundColor3 = C.card, BorderSizePixel = 0, LayoutOrder = state.cardOrder })
	corner(card, 8)

	local thumbType = item.kind == "bundle" and "BundleThumbnail" or "Asset"
	local thumb = new("ImageButton", {
		BackgroundColor3 = C.thumb, BorderSizePixel = 0, Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 1, -50),
		ScaleType = Enum.ScaleType.Fit, AutoButtonColor = false,
		Image = item.img or ("rbxthumb://type=%s&id=%s&w=150&h=150"):format(thumbType, tostring(item.id)),
	}, card)
	corner(thumb, 6)

	local nameBtn = makeButton({
		Text = string.upper(item.name or "?"), TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.new(0, 6, 1, -38), Size = UDim2.new(1, -12, 0, 32), ZIndex = 2,
	}, card)

	local dark = Color3.fromRGB(20, 20, 22)
	local idBtn = makeButton({
		Text = "ID", TextSize = 11, BackgroundColor3 = dark, ZIndex = 3,
		Position = UDim2.new(1, -58, 0, 10), Size = UDim2.fromOffset(28, 20),
	}, card)
	local star = makeButton({
		Text = favIndex(item) and "★" or "☆", TextSize = 14, BackgroundColor3 = dark, ZIndex = 3,
		TextColor3 = favIndex(item) and C.gold or C.txt,
		Position = UDim2.new(1, -28, 0, 10), Size = UDim2.fromOffset(22, 20),
	}, card)
	local hk = makeButton({
		Text = "KEY", TextSize = 11, BackgroundColor3 = dark, ZIndex = 3,
		Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(60, 20), Visible = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, card)
	local del = makeButton({
		Text = "✕", TextSize = 11, BackgroundColor3 = dark, ZIndex = 3, TextColor3 = Color3.fromRGB(255, 120, 120),
		Position = UDim2.fromOffset(74, 10), Size = UDim2.fromOffset(22, 20), Visible = false,
	}, card)

	local hovered = false
	local function refreshHK()
		local e = Config.hotkeys[hkKey(item)]
		hk.Text = e and e.key or "KEY"
		hk.TextColor3 = e and C.gold or C.dim
		hk.Visible = hovered or e ~= nil
		del.Visible = hovered and state.tab ~= "favs"
	end
	refreshHK()

	card.MouseEnter:Connect(function() hovered = true; refreshHK() end)
	card.MouseLeave:Connect(function()
		if mouseInside(card) then return end
		hovered = false
		refreshHK()
	end)

	nameBtn.MouseButton1Click:Connect(function() activate(item) end)
	thumb.MouseButton1Click:Connect(function() activate(item) end)
	idBtn.MouseButton1Click:Connect(function()
		pcall(function() if setclipboard then setclipboard(tostring(item.id)) end end)
		notify("ID copied: " .. tostring(item.id))
	end)
	star.MouseButton1Click:Connect(function()
		local i = favIndex(item)
		if i then
			table.remove(Config.favs, i)
		else
			-- un favorito siempre queda tambien guardado en su pestana
			saveItem(item, true)
			return
		end
		save()
		refreshPreviewButtons()
		if state.tab == "favs" then
			showTab(nil)
		else
			star.Text = "☆"
			star.TextColor3 = C.txt
		end
	end)
	del.MouseButton1Click:Connect(function() removeItem(item) end)
	hk.MouseButton1Click:Connect(function()
		hk.Text = "..."
		hk.TextColor3 = C.white
		capture = function(kc)
			if kc == Enum.KeyCode.Escape then
				Config.hotkeys[hkKey(item)] = nil
			else
				Config.hotkeys[hkKey(item)] = { kind = item.kind, id = item.id, name = item.name, key = kc.Name }
			end
			save()
			if hk.Parent then refreshHK() end
		end
	end)

	return card
end

local function relayout()
	local W = Grid.AbsoluteSize.X - 8
	local cols = math.max(1, math.floor((W + 8) / 158))
	local cellW = math.floor((W - (cols - 1) * 8) / cols)
	GridLayout.CellSize = UDim2.fromOffset(cellW, math.floor(cellW * 0.82) + 46)
end
connect(Grid:GetPropertyChangedSignal("AbsoluteSize"), relayout)

local function clearCards()
	for _, c in ipairs(Grid:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end
	state.cardOrder = 0
end

local function updateTabStyle()
	for key, b in pairs(tabButtons) do
		local on = key == state.tab
		b.BackgroundColor3 = on and C.white or C.btn
		b.TextColor3 = on and C.black or C.txt
	end
end

-- showTab(nil) vuelve a dibujar la pestana actual
showTab = function(tab)
	local keepScroll = tab == nil
	tab = tab or state.tab
	if tab ~= state.tab then state.filter = ""; SearchBox.Text = "" end
	state.tab = tab
	updateTabStyle()
	local isMix = tab == "mix"
	Grid.Visible = not isMix
	MixPage.Visible = isMix
	SearchBox.PlaceholderText = tab == "favs" and "Name" or "Zombie, Cute"
	IdBox.PlaceholderText = "Url or ID"
	if isMix then
		EmptyLabel.Visible = false
	else
		local pos = Grid.CanvasPosition
		clearCards()
		relayout()
		local source = tab == "emotes" and Config.emotes or tab == "bundles" and Config.packs or Config.favs
		local count = 0
		for _, it in ipairs(source) do
			if state.filter == "" or string.find(string.lower(it.name or ""), state.filter, 1, true) then
				createCard(it).Parent = Grid
				count += 1
			end
		end
		if keepScroll then Grid.CanvasPosition = pos else Grid.CanvasPosition = Vector2.new(0, 0) end
		EmptyLabel.Visible = count == 0
		if count == 0 then
			if state.filter ~= "" then
				EmptyLabel.Text = "No results for that name."
			elseif tab == "emotes" then
				EmptyLabel.Text = "No saved emotes yet.\nPaste an emote ID or link above, or play an emote in your game and press SAVE."
			elseif tab == "bundles" then
				EmptyLabel.Text = "No saved packs yet.\nPaste an animation pack ID or link above and press APPLY, then SAVE."
			else
				EmptyLabel.Text = "No favorites yet. Press the star on any emote or pack."
			end
		end
	end
	setStatus()
end

for key, b in pairs(tabButtons) do
	b.MouseButton1Click:Connect(function() showTab(key) end)
end

local function doSearch()
	if state.tab == "mix" then return end
	state.filter = string.lower(SearchBox.Text)
	showTab(nil)
end
