	end)
	star.MouseButton1Click:Connect(function()
		local i = __BA_STATE.favIndex(item)
		if i then
			table.remove(__BA_STATE.Config.favs, i)
		else
			-- un favorito siempre queda tambien guardado en su pestana
			__BA_STATE.saveItem(item, true)
			return
		end
		__BA_STATE.save()
		__BA_STATE.refreshPreviewButtons()
		if __BA_STATE.state.tab == "favs" then
