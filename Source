local function createProfile()
	local name = (profileNameBox.Text:gsub("^%s+", ""):gsub("%s+$", ""))
	if name == "" then
		notify("Enter a profile name first")
		return
	end
	local _, existing = findProfile(name)
	if existing then
		notify("That profile already exists. Use UPDATE on its row.")
		return
	end
	table.insert(Config.profiles, {
		name = name,
		hotkeys = copyHotkeys(Config.hotkeys),
	})
	Config.activeProfile = name
	profileNameBox.Text = ""
	save()
	renderProfiles()
	notify("Profile saved: " .. name)
end
