__BA_STATE.Char, __BA_STATE.Hum, __BA_STATE.Animator = nil
function __BA_STATE.refreshChar()
	__BA_STATE.Char = __BA_STATE.LP.Character
	__BA_STATE.Hum = __BA_STATE.Char and __BA_STATE.Char:FindFirstChildOfClass("Humanoid")
	__BA_STATE.Animator = __BA_STATE.Hum and __BA_STATE.Hum:FindFirstChildWhichIsA("Animator", true)
	return __BA_STATE.Animator ~= nil
end
__BA_STATE.refreshChar()

__BA_STATE.notify, __BA_STATE.showPreview, __BA_STATE.showTab, __BA_STATE.refreshPreviewButtons = nil -- se definen mas abajo

__BA_STATE.ourTracks = setmetatable({}, { __mode = "k" })  -- tracks creados por este script
__BA_STATE.emote = { __BA_STATE.track = nil, id = nil, token = 0, startedAt = 0 }
__BA_STATE.clickImg = { image = nil, t = 0 }  -- ultima imagen clickeada en la GUI del juego

-- IDs de animacion que usa el script Animate (idle, walk, run...)
function __BA_STATE.animateIdSet()
	local set = {}
	local an = __BA_STATE.Char and __BA_STATE.Char:FindFirstChild("Animate")
	if an then
		for _, d in ipairs(an:GetDescendants()) do
			if d:IsA("Animation") then
				local n = __BA_STATE.normId(d.AnimationId)
				if n then set[n] = true end
			end
		end
	end
	return set
end

-- Un "emote del juego" = animacion de prioridad Action que no viene de Animate
function __BA_STATE.isGameEmoteTrack(t, set)
	local pr = t.Priority.Value
	if pr < 2 or pr > 5 then return false end
	local anim = t.Animation
	local id = anim and __BA_STATE.normId(anim.AnimationId)
	return id ~= nil and not set[id]
end

function __BA_STATE.stopGameEmotes()
	if not __BA_STATE.Animator then return end
	local set = __BA_STATE.animateIdSet()
	for _, t in ipairs(__BA_STATE.Animator:GetPlayingAnimationTracks()) do
		if not __BA_STATE.ourTracks[t] and __BA_STATE.isGameEmoteTrack(t, set) then
			pcall(function() t:Stop(0.1) end)
		end
	end
end

function __BA_STATE.stopEmote(fade)
	__BA_STATE.emote.token += 1
	if __BA_STATE.emote.track then
		pcall(function() __BA_STATE.emote.track:Stop(fade or 0.2) end)
	end
	__BA_STATE.emote.track = nil
	__BA_STATE.emote.id = nil
end

-- Reproduce un emote.
-- Si presionas el mismo emote mientras está reproduciéndose, lo detiene.
-- Si eliges otro emote, detiene el anterior y reproduce el nuevo.
function __BA_STATE.playEmote(id, name, silent, img)
	id = tostring(id)

	if not __BA_STATE.refreshChar() then
		__BA_STATE.notify("No character / Animator found")
		return
	end

	-- Si este mismo emote ya está reproduciéndose, detenerlo.
	if __BA_STATE.emote.id == id and __BA_STATE.emote.track and __BA_STATE.emote.track.IsPlaying then
		__BA_STATE.stopEmote(0.2)

		if not silent then
			__BA_STATE.notify("Emote stopped: " .. tostring(name))
		end

		return
	end

	-- Si es otro emote, detener el anterior antes de reproducir el nuevo.
	stopEmote(0)
	__BA_STATE.stopGameEmotes()
	local token = __BA_STATE.emote.token
	__BA_STATE.emote.id = id
	task.spawn(function()
		local animId = __BA_STATE.resolveAnimId(id)
		if token ~= __BA_STATE.emote.token then return end
		local a = Instance.new("Animation")
		a.AnimationId = animId
		local ok, __BA_STATE.track = pcall(function() return __BA_STATE.Animator:LoadAnimation(a) end)
		if not ok or not __BA_STATE.track then
			__BA_STATE.emote.id = nil
			__BA_STATE.notify("Could not load emote")
			return
		end
		__BA_STATE.ourTracks[__BA_STATE.track] = true
		__BA_STATE.track.Priority = Enum.AnimationPriority.Action4
		__BA_STATE.track:Play(0.1, 1, __BA_STATE.Config.speed)
		__BA_STATE.track.TimePosition = 0
		__BA_STATE.emote.track = __BA_STATE.track
		__BA_STATE.emote.startedAt = os.clock()
		__BA_STATE.track.Stopped:Connect(function()
			if __BA_STATE.emote.track == __BA_STATE.track then __BA_STATE.emote.track = nil; __BA_STATE.emote.id = nil end
		end)
		__BA_STATE.notify("Emote: " .. tostring(name))
		if not silent then
			__BA_STATE.showPreview({ kind = "emote", id = id, name = name, img = img }, "NOW PLAYING")
		end
	end)
end

__BA_STATE.SLOT_ORDER = { "idle", "walk", "run", "jump", "fall", "climb", "swim" }
__BA_STATE.SLOT_PATHS = {
	idle = { { "idle", "Animation1" }, { "idle", "Animation2" } },
	walk = { { "walk", "WalkAnim" } },
	run = { { "run", "RunAnim" } },
	jump = { { "jump", "JumpAnim" } },
	fall = { { "fall", "FallAnim" } },
	climb = { { "climb", "ClimbAnim" } },
	swim = { { "swim", "Swim" } },
}

__BA_STATE.original = {}
__BA_STATE.currentSlots = {}

function __BA_STATE.setAnimateDisabled(animate, v)
	pcall(function() animate.Disabled = v end)
	pcall(function() animate.Enabled = not v end)
end

function __BA_STATE.writeSlots(animate)
	for slot, id in pairs(__BA_STATE.currentSlots) do
		for _, p in ipairs(__BA_STATE.SLOT_PATHS[slot] or {}) do
			local f = animate:FindFirstChild(p[1])
			local v = f and f:FindFirstChild(p[2])
			if v then
				local key = p[1] .. "." .. p[2]
				if __BA_STATE.original[key] == nil then __BA_STATE.original[key] = v.AnimationId end
				v.AnimationId = id
			end
		end
	end
end

function __BA_STATE.restartAnimate(animate)
	__BA_STATE.setAnimateDisabled(animate, true)
	if __BA_STATE.Animator then
		for _, t in ipairs(__BA_STATE.Animator:GetPlayingAnimationTracks()) do
			if t ~= __BA_STATE.emote.track then pcall(function() t:Stop(0) end) end
		end
	end
	task.wait()
	__BA_STATE.setAnimateDisabled(animate, false)
end

function __BA_STATE.applySlots(slots)
	__BA_STATE.refreshChar()
	local animate = __BA_STATE.Char and __BA_STATE.Char:FindFirstChild("Animate")
	if not animate then
		__BA_STATE.notify("No 'Animate' script found in your character")
		return false
	end
	for s, id in pairs(slots) do __BA_STATE.currentSlots[s] = id end
	__BA_STATE.writeSlots(animate)
	__BA_STATE.restartAnimate(animate)
	return true
end

function __BA_STATE.slotsFromInfo(info)
	local slots = {}
	for _, it in ipairs(info.Items or {}) do
		local iid = it.Id or it.id
		local itype = it.Type or it.type
		if itype == "Asset" and iid then
			local n = string.lower(it.Name or it.name or "")
			for _, s in ipairs(__BA_STATE.SLOT_ORDER) do
				if n:find(s, 1, true) then
					if not slots[s] then slots[s] = __BA_STATE.resolveAnimId(iid) end
					break
				end
			end
		end
	end
	return slots
end

function __BA_STATE.applyBundle(item, silent)
	task.spawn(function()
		__BA_STATE.notify("Applying pack...")
		local info = item.info or __BA_STATE.bundleInfo(item.id)
		if not info then
			__BA_STATE.notify("Could not read pack " .. tostring(item.id))
			return
		end
		local slots = __BA_STATE.slotsFromInfo(info)
		if next(slots) == nil then
			__BA_STATE.notify("That pack has no walk/run/idle animations")
			return
		end
		if __BA_STATE.applySlots(slots) then
			__BA_STATE.notify("Pack: " .. tostring(item.name))
			if not silent then
				local names = {}
				for _, s in ipairs(__BA_STATE.SLOT_ORDER) do
					if slots[s] then table.insert(names, s) end
				end
				__BA_STATE.showPreview({ kind = "bundle", id = tostring(item.id), name = item.name }, "PACK APPLIED", table.concat(names, ", "))
			end
		end
	end)
end

function __BA_STATE.resetAnimations()
	__BA_STATE.stopEmote()
	__BA_STATE.refreshChar()
	local animate = __BA_STATE.Char and __BA_STATE.Char:FindFirstChild("Animate")
	__BA_STATE.currentSlots = {}
	if animate then
		for key, id in pairs(__BA_STATE.original) do
			local f, n = key:match("([^.]+)%.(.+)")
			local folder = f and animate:FindFirstChild(f)
			local v = folder and folder:FindFirstChild(n)
			if v then v.AnimationId = id end
		end
		__BA_STATE.original = {}
		task.spawn(__BA_STATE.restartAnimate, animate)
	end
	__BA_STATE.notify("Animations reset")
end

__BA_STATE.connect(__BA_STATE.LP.CharacterAdded, function(c)
	__BA_STATE.original = {}
	__BA_STATE.emote.track = nil
	__BA_STATE.emote.id = nil
	task.spawn(function()
		c:WaitForChild("Humanoid", 10)
		c:WaitForChild("Animate", 10)
		task.wait(0.6)
		__BA_STATE.refreshChar()
		if next(__BA_STATE.currentSlots) then __BA_STATE.applySlots({}) end
	end)
end)

----------------------------------------------------------------
-- Biblioteca (guardados) y favoritos
----------------------------------------------------------------
function __BA_STATE.libList(kind) return kind == "bundle" and Config.packs or Config.emotes end
function __BA_STATE.libIndex(item)
	for i, v in ipairs(__BA_STATE.libList(item.kind)) do
		if tostring(v.id) == tostring(item.id) then return i end
	end
end
function __BA_STATE.favIndex(item)
	for i, f in ipairs(__BA_STATE.Config.favs) do
		if f.kind == item.kind and tostring(f.id) == tostring(item.id) then return i end
	end
end
function __BA_STATE.hkKey(item) return item.kind .. ":" .. tostring(item.id) end

-- Copia independiente de los atajos para que cada perfil tenga su propio mapa.
function __BA_STATE.copyHotkeys(source)
	local result = {}
	for key, value in pairs(source or {}) do
		if type(value) == "table" then
			result[key] = {
				kind = value.kind,
				id = tostring(value.id or ""),
				name = value.name or "",
				key = value.key,
			}
		end
	end
	return result
end

function __BA_STATE.findProfile(name)
	local wanted = string.lower((tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")))
	for index, profile in ipairs(__BA_STATE.Config.profiles) do
		if string.lower(profile.name or "") == wanted then
			return index, profile
		end
	end
end

function __BA_STATE.collectionProfiles(kind)
	return kind == "bundle" and __BA_STATE.Config.packProfiles or __BA_STATE.Config.emoteProfiles
end

function __BA_STATE.findCollectionFolder(kind, name)
	local wanted = string.lower((tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")))
	for index, folder in ipairs(__BA_STATE.collectionProfiles(kind)) do
		if string.lower(folder.name or "") == wanted then return index, folder end
	end
end

function __BA_STATE.addItemToCollection(kind, folderName, item)
	local _, folder = __BA_STATE.findCollectionFolder(kind, folderName)
	if not folder then return false end
	folder.items = folder.items or {}
	for _, saved in ipairs(folder.items) do
		if tostring(saved.id) == tostring(item.id) then return true end
	end
	table.insert(folder.items, { kind = kind, id = tostring(item.id), name = item.name or ((kind == "bundle" and "Pack " or "Emote ") .. tostring(item.id)), img = item.img })
	__BA_STATE.save()
	return true
end

function __BA_STATE.copyMixSlots(source)
	local result = {}
	for _, slot in ipairs(__BA_STATE.SLOT_ORDER) do
		if source and source[slot] and tostring(source[slot]) ~= "" then result[slot] = tostring(source[slot]) end
	end
	return result
end

function __BA_STATE.syncActiveProfile()
	if __BA_STATE.Config.activeProfile == "" then return end
	local _, profile = __BA_STATE.findProfile(__BA_STATE.Config.activeProfile)
	if profile then
		profile.hotkeys = __BA_STATE.copyHotkeys(__BA_STATE.Config.hotkeys)
	end
end

function __BA_STATE.saveItem(item, fav)
	local name = (item.name and item.name ~= "") and item.name or ((item.kind == "bundle" and "Pack " or "Emote ") .. tostring(item.id))
	local entry = { kind = item.kind, id = tostring(item.id), name = name, img = item.img }
	if not __BA_STATE.libIndex(entry) then table.insert(__BA_STATE.libList(entry.kind), entry) end
	if fav and not __BA_STATE.favIndex(entry) then
		table.insert(__BA_STATE.Config.favs, { kind = entry.kind, id = entry.id, name = entry.name, img = entry.img })
	end
	__BA_STATE.save()
	__BA_STATE.refreshPreviewButtons()
	__BA_STATE.showTab(nil)
end

function __BA_STATE.removeItem(item)
	local list = __BA_STATE.libList(item.kind)
	local i = __BA_STATE.libIndex(item)
	if i then table.remove(list, i) end
	local fi = __BA_STATE.favIndex(item)
	if fi then table.remove(__BA_STATE.Config.favs, fi) end
	__BA_STATE.Config.hotkeys[__BA_STATE.hkKey(item)] = nil
	__BA_STATE.syncActiveProfile()
	__BA_STATE.save()
	__BA_STATE.refreshPreviewButtons()
	__BA_STATE.showTab(nil)
end

function __BA_STATE.activate(item)
	if item.kind == "bundle" then
		__BA_STATE.applyBundle({ kind = "bundle", id = item.id, name = item.name }, true)
	else
		__BA_STATE.playEmote(item.id, item.name, true)
	end
end

----------------------------------------------------------------
-- Velocidad, cancelar emote al moverse, deteccion de emotes del juego
----------------------------------------------------------------
__BA_STATE.prevPlaying = {}
function __BA_STATE.detectEmotes()
	if not __BA_STATE.Animator then return end
	local cur = {}
	local animateSet
	for _, t in ipairs(__BA_STATE.Animator:GetPlayingAnimationTracks()) do
		cur[t] = true
		-- solo cuenta cuando una animacion EMPIEZA (asi se detecta cada vez que se repite)
		if not __BA_STATE.prevPlaying[t] and not __BA_STATE.ourTracks[t] then
			animateSet = animateSet or __BA_STATE.animateIdSet()
			if not (__BA_STATE.Char and __BA_STATE.Char:FindFirstChildOfClass("Tool")) and __BA_STATE.isGameEmoteTrack(t, animateSet) then
				-- el juego empezo un emote: se corta el nuestro para no mezclar dos
				if __BA_STATE.emote.track then __BA_STATE.stopEmote(0.1) end
				local id = __BA_STATE.normId(t.Animation.AnimationId)
				if __BA_STATE.Config.detect and id and not __BA_STATE.libIndex({ kind = "emote", id = id }) then
					local img = (__BA_STATE.clickImg.image and os.clock() - __BA_STATE.clickImg.t < 2.5) and __BA_STATE.clickImg.image or nil
					task.spawn(function()
						local info = __BA_STATE.assetInfo(id)
						local name = info and info.Name or ("Emote " .. id)
						if not img and info and info.IconImageAssetId and info.IconImageAssetId ~= 0 then
							img = "rbxassetid://" .. tostring(info.IconImageAssetId)
						end
						__BA_STATE.showPreview({ kind = "emote", id = id, name = name, img = img }, "EMOTE DETECTED", nil, 25)
					end)
				end
			end
		end
	end
	__BA_STATE.prevPlaying = cur
end

__BA_STATE.speedModified = false
__BA_STATE.lastCheck = 0
__BA_STATE.connect(__BA_STATE.RunService.Heartbeat, function()
	if not __BA_STATE.Animator or not __BA_STATE.Animator.Parent then __BA_STATE.refreshChar() end
	if __BA_STATE.emote.track then
		pcall(function() __BA_STATE.emote.track:AdjustSpeed(__BA_STATE.Config.speed) end)
		if not __BA_STATE.Config.keepEmote and __BA_STATE.Hum and os.clock() - __BA_STATE.emote.startedAt > 0.35 then
			local st = __BA_STATE.Hum:GetState()
			if __BA_STATE.Hum.MoveDirection.Magnitude > 0.1 or st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall then
				__BA_STATE.stopEmote()
			end
		end
	elseif __BA_STATE.Animator then
		if math.abs(__BA_STATE.Config.speed - 1) > 0.001 then
			__BA_STATE.speedModified = true
			for _, t in ipairs(__BA_STATE.Animator:GetPlayingAnimationTracks()) do
				pcall(function() t:AdjustSpeed(__BA_STATE.Config.speed) end)
			end
		elseif __BA_STATE.speedModified then
			__BA_STATE.speedModified = false
			for _, t in ipairs(__BA_STATE.Animator:GetPlayingAnimationTracks()) do
				pcall(function() t:AdjustSpeed(1) end)
			end
		end
	end
	if os.clock() - __BA_STATE.lastCheck > 0.15 then
		__BA_STATE.lastCheck = os.clock()
		pcall(__BA_STATE.detectEmotes)
	end
end)

