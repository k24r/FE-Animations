-- Cuando haces click en la GUI de tu juego (por ejemplo "reproducir emote"), guarda la imagen
-- mas grande de ese boton/tarjeta para usarla como miniatura del emote detectado.
local function findImageNear(obj)
	local node = obj
	for _ = 1, 6 do
		if not node or node:IsA("PlayerGui") or node:IsA("LayerCollector") then break end
		local best, bestArea = nil, 0
		local list = { node }
		for _, d in ipairs(node:GetDescendants()) do list[#list + 1] = d end
		for _, d in ipairs(list) do
			if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d.Image ~= "" and d.Visible
				and d.AbsoluteSize.X >= 40 and d.AbsoluteSize.Y >= 40 then
				local area = d.AbsoluteSize.X * d.AbsoluteSize.Y
				if area > bestArea and area < 300000 then best, bestArea = d, area end
			end
		end
		if best then return best.Image end
		node = node.Parent
	end
end

connect(UIS.InputBegan, function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
	pcall(function()
		local pg = LP:FindFirstChildOfClass("PlayerGui")
		if not pg then return end
		for _, o in ipairs(pg:GetGuiObjectsAtPosition(input.Position.X, input.Position.Y)) do
			if not o:IsDescendantOf(gui) then
				local img = findImageNear(o)
				if img then
					clickImg.image, clickImg.t = img, os.clock()
				end
				return
			end
		end
	end)
end)

local function draggable(handle, frame)
	local dragging, dragStart, startPos = false, nil, nil
	connect(handle.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = i.Position
			startPos = frame.Position
		end
	end)
	connect(UIS.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - dragStart
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	connect(UIS.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

local function makeButton(props, parent)
	local b = new("TextButton", {
		BackgroundColor3 = C.btn, BorderSizePixel = 0, AutoButtonColor = true,
		Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = C.txt,
	}, nil)
