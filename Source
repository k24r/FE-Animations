function __BA_STATE.renderMixProfiles()
	for _, child in ipairs(__BA_STATE.mixProfileRows:GetChildren()) do if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end end
	for index, profile in ipairs(__BA_STATE.Config.mixProfiles) do
		local row = __BA_STATE.new("Frame", { BackgroundColor3 = __BA_STATE.C.card, BorderSizePixel = 0, Size = UDim2.new(1, -4, 0, 44), LayoutOrder = index }, __BA_STATE.mixProfileRows)
		__BA_STATE.corner(row, 7)
		local count = 0; for _, slot in ipairs(__BA_STATE.SLOT_ORDER) do if profile.slots and profile.slots[slot] and profile.slots[slot] ~= "" then count += 1 end end
		__BA_STATE.new("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -190, 1, 0), Text = profile.name .. "  (" .. count .. "/" .. #__BA_STATE.SLOT_ORDER .. " slots)", Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = __BA_STATE.C.txt, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd }, row)
		local load = __BA_STATE.makeButton({ Text = "LOAD", Position = UDim2.new(1, -176, 0, 7), Size = UDim2.fromOffset(76, 30), BackgroundColor3 = __BA_STATE.C.white, TextColor3 = __BA_STATE.C.black }, row)
		local del = __BA_STATE.makeButton({ Text = "✕", Position = UDim2.new(1, -92, 0, 7), Size = UDim2.fromOffset(80, 30), TextColor3 = Color3.fromRGB(255, 120, 120) }, row)
		load.MouseButton1Click:Connect(function()
			local slots = {}
			__BA_STATE.Config.mix = __BA_STATE.copyMixSlots(profile.slots)
			for _, slot in ipairs(__BA_STATE.SLOT_ORDER) do
				local raw = profile.slots and profile.slots[slot]
				if raw then local id = __BA_STATE.parseId(raw); if id then slots[slot] = __BA_STATE.resolveAnimId(id) end end
				if __BA_STATE.mixInputBoxes[slot] then __BA_STATE.mixInputBoxes[slot].Text = raw or "" end
			end
			__BA_STATE.save()
			if next(slots) and __BA_STATE.applySlots(slots) then __BA_STATE.notify("Mix loaded: " .. profile.name) else __BA_STATE.notify("This mix has no valid animation slots") end
		end)
		del.MouseButton1Click:Connect(function() table.remove(__BA_STATE.Config.mixProfiles, index); __BA_STATE.save(); __BA_STATE.renderMixProfiles() end)
	end
	if #__BA_STATE.Config.mixProfiles == 0 then __BA_STATE.new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 38), Text = "No saved mixes yet. Configure slots in MIX, then save one here.", Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = __BA_STATE.C.dim, TextXAlignment = Enum.TextXAlignment.Left }, __BA_STATE.mixProfileRows) end
end

__BA_STATE.mixProfileSaveBtn.MouseButton1Click:Connect(function()
