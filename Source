__BA_STATE.connect(__BA_STATE.UIS.InputBegan, function(input, processed)
	if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	if __BA_STATE.capture then
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			local f = __BA_STATE.capture
			__BA_STATE.capture = nil
			f(input.KeyCode)
		end
		return
	end
	if processed then return end
	local name = input.KeyCode.Name
	if name == __BA_STATE.Config.menuKey then
		__BA_STATE.Main.Visible = not __BA_STATE.Main.Visible
		__BA_STATE.FloatingK24.Visible = not __BA_STATE.Main.Visible
		return
	end
	for _, e in pairs(__BA_STATE.Config.hotkeys) do
		if e.key == name then
			__BA_STATE.activate(e)
			break
		end
	end
end)

